{
  "name": "@buisnez/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-test": "prisma migrate reset --force --skip-generate --skip-seed && tsx prisma/seed.ts",
    "db:import-businesses": "tsx ../../scripts/import-businesses.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo 'No database tests yet'"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.16.2",
    "csv-parse": "^5.6.0"
  },
  "devDependencies": {
    "@buisnez/config": "workspace:*",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "prisma": "^6.16.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
