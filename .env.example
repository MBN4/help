# OAuth (Phase 5) — leave blank locally to run the stubbed provider handshake.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/v1

# Object storage (Phase 5) — MinIO locally (remapped to 9102, see docker-compose.yml), R2 in prod.
S3_ENDPOINT=http://localhost:9102
S3_REGION=auto
S3_ACCESS_KEY_ID=buisnez
S3_SECRET_ACCESS_KEY=buisnez-dev-password
S3_BUCKET=buisnez-photos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9102/buisnez-photos

MINIO_ROOT_USER=buisnez
MINIO_ROOT_PASSWORD=buisnez-dev-password
