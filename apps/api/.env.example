DATABASE_URL=postgresql://buisnez:buisnez@localhost:5544/buisnez
REDIS_URL=redis://localhost:6390
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
GOOGLE_MAPS_API_KEY=
WEB_ORIGIN=http://localhost:3000

# OAuth (Phase 5) — leave blank locally to run the stubbed provider handshake; email/password stays fully working.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/v1

# Object storage (Phase 5 photo uploads) — MinIO locally (remapped to 9102, see docker-compose.yml), R2 in prod.
S3_ENDPOINT=http://localhost:9102
S3_REGION=auto
S3_ACCESS_KEY_ID=buisnez
S3_SECRET_ACCESS_KEY=buisnez-dev-password
S3_BUCKET=buisnez-photos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9102/buisnez-photos

# On-demand ISR revalidation (Phase 4/5) — must match apps/web's REVALIDATE_SECRET.
REVALIDATE_SECRET=replace-with-a-long-random-secret
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
