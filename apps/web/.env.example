NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
WEB_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=replace-with-a-long-random-secret
