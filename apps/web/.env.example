NEXT_PUBLIC_S3_PUBLIC_HOST=localhost:9102
# Optional web observability — both integrations stay fully inert (no network calls) when unset.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
