{
  "name": "buisnez",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e:reset": "bash scripts/reset-test-env.sh",
    "test:e2e:all": "pnpm --filter @buisnez/api test:e2e && pnpm --filter @buisnez/web test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,tsx,json,md,yml,yaml,css}": "prettier --write"
  }
}
